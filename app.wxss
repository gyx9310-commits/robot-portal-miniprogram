page {
  background-color: #f8f9fa;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  min-height: 100vh;
  padding: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2c3e50;
  text-align: center;
  margin-bottom: 32rpx;
  position: relative;
}

.section-title::after {
  content: '';
  display: block;
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #4a90d9, #357abd);
  margin: 16rpx auto 0;
  border-radius: 2rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-outline {
  background: transparent;
  color: #4a90d9;
  border: 2rpx solid #4a90d9;
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.text-primary {
  color: #4a90d9;
}

.text-gradient {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mt-20 { margin-top: 32rpx; }
.mb-20 { margin-bottom: 32rpx; }
.mt-40 { margin-top: 64rpx; }
.mb-40 { margin-bottom: 64rpx; }

.text-muted {
  color: #95a5a6;
}

.text-dark {
  color: #2c3e50;
}
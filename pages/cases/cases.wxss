page {
  background: #0a0e1a;
}

.container {
  min-height: 100vh;
}

.page-header {
  text-align: center;
  padding: 48rpx 0 40rpx;
  background: linear-gradient(180deg, #1a2744 0%, #0d1321 100%);
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  top: -50%;
  left: 50%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(74, 144, 217, 0.3) 0%, transparent 70%);
  transform: translateX(-50%);
  animation: headerGlow 4s ease-in-out infinite;
}

@keyframes headerGlow {
  0%, 100% {
    transform: translateX(-50%) scale(1);
    opacity: 0.5;
  }
  50% {
    transform: translateX(-50%) scale(1.3);
    opacity: 0.8;
  }
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 0 20rpx rgba(74, 144, 217, 0.5);
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}

.gallery-section {
  padding: 40rpx 24rpx;
  background: linear-gradient(180deg, #0d1321 0%, #0a0e1a 100%);
}

.case-title {
  text-align: center;
  margin-bottom: 32rpx;
  position: relative;
  padding: 0 40rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  position: relative;
  display: inline-block;
  padding: 0 32rpx;
}

.title-text::before,
.title-text::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 40rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(74, 144, 217, 0.6), transparent);
}

.title-text::before {
  left: -60rpx;
}

.title-text::after {
  right: -60rpx;
}

.cases-gallery {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.case-item {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.4), 0 0 24rpx rgba(74, 144, 217, 0.15);
  background: #1a2744;
  border: 2rpx solid rgba(74, 144, 217, 0.2);
  transition: all 0.3s ease;
}

.case-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.08) 0%, rgba(53, 123, 189, 0.08) 100%);
  z-index: 1;
  pointer-events: none;
}

.case-image {
  width: 100%;
  height: 520rpx;
  display: block;
  position: relative;
  z-index: 0;
}

.case-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 24rpx 40rpx;
  background: linear-gradient(transparent, rgba(10, 14, 26, 0.95));
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  font-weight: 600;
  letter-spacing: 2rpx;
  z-index: 2;
  position: relative;
}

.case-caption::before {
  content: '';
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #4a90d9, transparent);
  border-radius: 2rpx;
}

.cases-footer {
  margin-top: 48rpx;
  padding: 36rpx 32rpx;
  background: rgba(74, 144, 217, 0.08);
  border-radius: 20rpx;
  border: 1rpx solid rgba(74, 144, 217, 0.25);
  position: relative;
  overflow: hidden;
}

.cases-footer::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(74, 144, 217, 0.5), transparent);
}

.cases-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.9;
  text-align: center;
  position: relative;
  z-index: 1;
}

.stats-section {
  display: flex;
  justify-content: space-around;
  background: linear-gradient(135deg, rgba(26, 39, 68, 0.6) 0%, rgba(13, 19, 33, 0.6) 100%);
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  margin: 40rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2), 0 0 24rpx rgba(74, 144, 217, 0.1);
  border: 1rpx solid rgba(74, 144, 217, 0.2);
  position: relative;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #64c8ff 0%, #4a90d9 50%, #357abd 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 10rpx;
  text-shadow: 0 0 20rpx rgba(100, 200, 255, 0.3);
  position: relative;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.cta-section {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 28rpx;
  padding: 52rpx 32rpx;
  text-align: center;
  margin: 40rpx 24rpx 80rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 144, 217, 0.4), 0 0 32rpx rgba(74, 144, 217, 0.2);
  position: relative;
  overflow: hidden;
}

.cta-section::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -30%;
  width: 160%;
  height: 200%;
  background: linear-gradient(135deg, transparent 0%, rgba(255, 255, 255, 0.1) 50%, transparent 100%);
  transform: rotate(45deg);
  animation: shimmer 6s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% {
    transform: translateX(-100%) rotate(45deg);
    opacity: 0;
  }
  50% {
    transform: translateX(100%) rotate(45deg);
    opacity: 1;
  }
}

.cta-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.cta-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
}

.btn-primary {
  background: #fff;
  color: #4a90d9;
  font-size: 32rpx;
  font-weight: 700;
  padding: 26rpx 72rpx;
  border-radius: 52rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2), 0 0 16rpx rgba(255, 255, 255, 0.3);
  position: relative;
  z-index: 1;
  overflow: hidden;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.98);
}
.page-header {
  text-align: center;
  padding: 32rpx 0 48rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #7f8c8d;
}

.stats-section {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #4a90d9;
  margin-bottom: 6rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #95a5a6;
}

.cases-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.case-card {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.case-image {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.1) 0%, rgba(53, 123, 189, 0.1) 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.case-content {
  flex: 1;
}

.case-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.case-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
}

.case-badge {
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
}

.case-location {
  display: block;
  font-size: 24rpx;
  color: #95a5a6;
  margin-bottom: 10rpx;
}

.case-desc {
  display: block;
  font-size: 26rpx;
  color: #7f8c8d;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.case-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag {
  background: rgba(74, 144, 217, 0.1);
  color: #4a90d9;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.testimonials-section {
  margin-bottom: 48rpx;
}

.testimonials-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.testimonial-item {
  display: flex;
  gap: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.testimonial-avatar {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.testimonial-content {
  flex: 1;
}

.testimonial-text {
  display: block;
  font-size: 26rpx;
  color: #2c3e50;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.testimonial-author {
  display: block;
  font-size: 24rpx;
  color: #95a5a6;
}

.cta-section {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 100rpx;
}

.cta-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.cta-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 24rpx;
}

.cta-section .btn-primary {
  background: #fff;
  color: #4a90d9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}
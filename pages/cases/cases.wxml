<view class="container">
  <view class="page-header">
    <text class="page-title">试点案例</text>
    <text class="page-subtitle">高端幼儿园试点落地展示</text>
  </view>

  <view class="gallery-section">
    <view class="case-title">
      <text class="title-text">高端幼儿园试点落地 · 实景展示</text>
    </view>

    <view class="cases-gallery">
      <view class="case-item" wx:for="{{cases}}" wx:key="id" bindtap="previewImage" data-url="{{item.url}}">
        <image class="case-image" src="{{item.url}}" mode="aspectFill"></image>
        <text class="case-caption">{{item.caption}}</text>
      </view>
    </view>

    <view class="cases-footer">
      <text class="cases-desc">目前已在多家高端幼儿园试点投放，聚焦前厅迎宾、会客厅陪伴两大核心场景，收集真实使用反馈，持续优化产品体验</text>
    </view>
  </view>

  <view class="stats-section">
    <view class="stat-item">
      <text class="stat-value">3</text>
      <text class="stat-label">合作园所</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">50+</text>
      <text class="stat-label">实地调研</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">96%</text>
      <text class="stat-label">家长满意度</text>
    </view>
  </view>

  <view class="cta-section">
    <text class="cta-title">加入我们的合作伙伴</text>
    <text class="cta-desc">让更多孩子享受智能教育的乐趣</text>
    <button class="btn-primary" bindtap="goToContact">申请合作</button>
  </view>
</view>
.product-header {
  margin-bottom: 48rpx;
}

.product-hero {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.robot-display {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.product-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.product-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.specs-section {
  margin-bottom: 48rpx;
}

.specs-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.spec-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.spec-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #4a90d9;
  margin-bottom: 6rpx;
}

.spec-label {
  display: block;
  font-size: 22rpx;
  color: #95a5a6;
}

.features-section {
  margin-bottom: 48rpx;
}

.features-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.feature-icon-wrap {
  width: 70rpx;
  height: 70rpx;
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.1) 0%, rgba(53, 123, 189, 0.1) 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feature-icon {
  font-size: 36rpx;
}

.feature-content {
  flex: 1;
}

.feature-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 10rpx;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: #7f8c8d;
  line-height: 1.5;
}

.advantages-section {
  margin-bottom: 48rpx;
}

.advantages-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.advantage-item {
  display: flex;
  gap: 20rpx;
}

.advantage-number {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  flex-shrink: 0;
}

.advantage-content {
  flex: 1;
  padding-top: 6rpx;
}

.advantage-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 10rpx;
}

.advantage-desc {
  display: block;
  font-size: 24rpx;
  color: #7f8c8d;
  line-height: 1.5;
}

.cta-section {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 100rpx;
}

.cta-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.cta-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 24rpx;
}

.cta-section .btn-primary {
  background: #fff;
  color: #4a90d9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}
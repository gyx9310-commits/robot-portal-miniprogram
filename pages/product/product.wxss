page {
  background: #0a0e1a;
}

.product-header {
  margin-bottom: 48rpx;
}

.product-hero {
  background: linear-gradient(180deg, #1a2744 0%, #0d1321 100%);
  border-radius: 24rpx;
  padding: 52rpx 32rpx;
  text-align: center;
  margin: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3), 0 0 24rpx rgba(74, 144, 217, 0.15);
  border: 1rpx solid rgba(74, 144, 217, 0.2);
}

.product-hero::before {
  content: '';
  position: absolute;
  top: -50%;
  left: 50%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(74, 144, 217, 0.3) 0%, transparent 70%);
  transform: translateX(-50%);
  animation: heroGlow 4s ease-in-out infinite;
}

@keyframes heroGlow {
  0%, 100% {
    transform: translateX(-50%) scale(1);
    opacity: 0.5;
  }
  50% {
    transform: translateX(-50%) scale(1.3);
    opacity: 0.8;
  }
}

.robot-display {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 0 20rpx rgba(74, 144, 217, 0.5));
}

.product-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 0 20rpx rgba(74, 144, 217, 0.5);
}

.product-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
}

.specs-section {
  margin-bottom: 48rpx;
  padding: 0 24rpx;
}

.specs-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.spec-item {
  background: linear-gradient(135deg, rgba(26, 39, 68, 0.6) 0%, rgba(13, 19, 33, 0.6) 100%);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 1rpx solid rgba(74, 144, 217, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2), 0 0 12rpx rgba(74, 144, 217, 0.08);
  transition: all 0.3s ease;
}

.spec-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(74, 144, 217, 0.3), transparent);
  border-radius: 16rpx 16rpx 0 0;
}

.spec-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #64c8ff 0%, #4a90d9 50%, #357abd 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 6rpx;
  text-shadow: 0 0 16rpx rgba(100, 200, 255, 0.3);
}

.spec-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

.features-section {
  margin-bottom: 48rpx;
  padding: 0 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
  margin-bottom: 24rpx;
  position: relative;
  display: inline-block;
  width: 100%;
}

.section-title::before,
.section-title::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(74, 144, 217, 0.6), transparent);
}

.section-title::before {
  left: 20rpx;
}

.section-title::after {
  right: 20rpx;
}

.features-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  gap: 20rpx;
  background: linear-gradient(135deg, rgba(26, 39, 68, 0.6) 0%, rgba(13, 19, 33, 0.6) 100%);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(74, 144, 217, 0.2);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.2), 0 0 16rpx rgba(74, 144, 217, 0.08);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.feature-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(74, 144, 217, 0.4), transparent);
}

.feature-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.25) 0%, rgba(53, 123, 189, 0.25) 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(74, 144, 217, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.feature-icon {
  font-size: 40rpx;
  filter: drop-shadow(0 0 8rpx rgba(74, 144, 217, 0.4));
}

.feature-content {
  flex: 1;
}

.feature-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 10rpx;
}

.feature-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
}

.advantages-section {
  margin-bottom: 48rpx;
  padding: 0 24rpx;
}

.advantages-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.advantage-item {
  display: flex;
  gap: 20rpx;
}

.advantage-number {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.4), 0 0 20rpx rgba(74, 144, 217, 0.2);
}

.advantage-content {
  flex: 1;
  padding-top: 6rpx;
}

.advantage-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 10rpx;
}

.advantage-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
}

.cta-section {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 28rpx;
  padding: 52rpx 32rpx;
  text-align: center;
  margin: 0 24rpx 100rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 144, 217, 0.4), 0 0 32rpx rgba(74, 144, 217, 0.2);
  position: relative;
  overflow: hidden;
}

.cta-section::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -30%;
  width: 160%;
  height: 200%;
  background: linear-gradient(135deg, transparent 0%, rgba(255, 255, 255, 0.1) 50%, transparent 100%);
  transform: rotate(45deg);
  animation: shimmer 6s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% {
    transform: translateX(-100%) rotate(45deg);
    opacity: 0;
  }
  50% {
    transform: translateX(100%) rotate(45deg);
    opacity: 1;
  }
}

.cta-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.cta-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.btn-primary {
  background: #fff;
  color: #4a90d9;
  font-size: 32rpx;
  font-weight: 700;
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2), 0 0 16rpx rgba(255, 255, 255, 0.3);
  position: relative;
  z-index: 1;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.98);
}
<view class="container">
  <view class="banner-section">
    <image class="banner-image" src="https://neeko-copilot.bytedance.net/api/text_to_image?prompt=Half-body%20bionic%20robot%20in%20high-end%20kindergarten%20lobby%20with%20modern%20interior%20design%20warm%20lighting%20professional%20photography&image_size=portrait_16_9" mode="aspectFill"></image>
    <view class="banner-overlay">
      <text class="banner-slogan">仿生智能 · 赋能高端幼教</text>
      <text class="banner-subtitle">半身仿生机器人 试点落地中</text>
    </view>
  </view>

  <view class="entry-section">
    <view class="entry-grid">
      <view class="entry-item" bindtap="goToProduct">
        <view class="entry-icon">🤖</view>
        <text class="entry-text">产品介绍</text>
      </view>
      <view class="entry-item" bindtap="goToCases">
        <view class="entry-icon">🏫</view>
        <text class="entry-text">试点案例</text>
      </view>
      <view class="entry-item" bindtap="goToContact">
        <view class="entry-icon">💬</view>
        <text class="entry-text">合作咨询</text>
      </view>
      <view class="entry-item" bindtap="goToAbout">
        <view class="entry-icon">🏢</view>
        <text class="entry-text">关于我们</text>
      </view>
    </view>
  </view>

  <view class="footer-section">
    <view class="footer-content">
      <text class="footer-slogan">专注半身仿生智能，打造高端幼教科技解决方案</text>
    </view>
  </view>
</view>
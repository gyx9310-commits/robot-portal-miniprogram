page {
  background: #0a0e1a;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0a0e1a;
}

.banner-section {
  position: relative;
  width: 100%;
  height: 45vh;
  overflow: hidden;
}

.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #0a0e1a 0%, #1a2744 50%, #0d1321 100%);
}

.banner-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(74, 144, 217, 0.3) 0%, transparent 70%);
  animation: glow-pulse 3s ease-in-out infinite;
}

.model-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  perspective: 1000px;
  z-index: 10;
}

.model-scene {
  position: relative;
  width: 320rpx;
  height: 400rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform-style: preserve-3d;
}

.model-card {
  position: relative;
  width: 280rpx;
  height: 360rpx;
  transform-style: preserve-3d;
  transition: transform 0.1s ease-out;
}

.model-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4), 0 0 40rpx rgba(74, 144, 217, 0.2);
}

.model-reflection {
  position: absolute;
  bottom: -60rpx;
  left: 0;
  width: 100%;
  height: 80rpx;
  background: linear-gradient(to bottom, rgba(74, 144, 217, 0.15), transparent);
  transform: rotateX(-90deg) translateY(40rpx);
  transform-origin: top center;
  border-radius: 0 0 16rpx 16rpx;
}

.model-shadow {
  position: absolute;
  bottom: 20rpx;
  width: 200rpx;
  height: 30rpx;
  background: radial-gradient(ellipse, rgba(0, 0, 0, 0.4) 0%, transparent 70%);
  filter: blur(10rpx);
}

.hint-text {
  margin-top: 30rpx;
  font-size: 22rpx;
  color: rgba(100, 200, 255, 0.6);
  letter-spacing: 4rpx;
  font-family: 'Courier New', monospace;
}

@keyframes glow-pulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.5;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.5);
    opacity: 0.8;
  }
}

.floating-particles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: rgba(100, 200, 255, 0.8);
  border-radius: 50%;
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) translateX(0);
    opacity: 0.3;
  }
  50% {
    transform: translateY(-30rpx) translateX(10rpx);
    opacity: 1;
  }
}

.banner-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.6;
  mix-blend-mode: overlay;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(10, 14, 26, 0.9) 0%,
    rgba(10, 14, 26, 0.7) 50%,
    rgba(10, 14, 26, 0.95) 100%
  );
}

.banner-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-container {
  position: relative;
  margin-bottom: 24rpx;
}

.logo-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 120rpx;
  height: 120rpx;
  border: 2rpx solid rgba(74, 144, 217, 0.5);
  border-radius: 50%;
  animation: ring-rotate 8s linear infinite;
}

@keyframes ring-rotate {
  from {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

.logo-icon {
  font-size: 64rpx;
  animation: icon-float 3s ease-in-out infinite;
}

@keyframes icon-float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.banner-slogan {
  display: block;
  font-size: 20rpx;
  color: rgba(100, 200, 255, 0.8);
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
  font-family: 'Courier New', monospace;
}

.banner-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  text-shadow: 0 0 20rpx rgba(74, 144, 217, 0.5);
}

.banner-subtitle {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  font-family: 'Courier New', monospace;
  margin-bottom: 20rpx;
}

.scan-line {
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(74, 144, 217, 0.8), transparent);
  animation: scan 2s linear infinite;
}

@keyframes scan {
  0% {
    transform: translateY(0);
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
  100% {
    transform: translateY(100rpx);
    opacity: 0;
  }
}

.entry-section {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #0a0e1a 0%, #0d1321 100%);
}

.entry-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.entry-grid {
  display: flex;
  justify-content: space-around;
  width: 100%;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  position: relative;
}

.entry-icon-wrapper {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-icon-inner {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.2) 0%, rgba(53, 123, 189, 0.1) 100%);
  border: 2rpx solid rgba(74, 144, 217, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  z-index: 1;
}

.entry-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  background: radial-gradient(circle, rgba(74, 144, 217, 0.3) 0%, transparent 70%);
  animation: icon-glow 2s ease-in-out infinite;
}

@keyframes icon-glow {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.5;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.3);
    opacity: 0.8;
  }
}

.entry-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.entry-border {
  width: 40rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(74, 144, 217, 0.8), transparent);
  margin-top: 8rpx;
}

.footer-section {
  width: 100%;
  padding: 32rpx;
  box-sizing: border-box;
  background: #0a0e1a;
  border-top: 1rpx solid rgba(74, 144, 217, 0.2);
}

.footer-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.footer-border {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(74, 144, 217, 0.6), transparent);
}

.footer-slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}

.footer-badge {
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(74, 144, 217, 0.4);
  border-radius: 32rpx;
  background: rgba(74, 144, 217, 0.1);
}

.badge-text {
  font-size: 18rpx;
  color: rgba(100, 200, 255, 0.8);
  letter-spacing: 4rpx;
  font-family: 'Courier New', monospace;
}
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8f9fa;
}

.banner-section {
  position: relative;
  width: 100%;
  height: 33.33vh;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
  padding: 32rpx;
}

.banner-slogan {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.banner-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.entry-section {
  width: 100%;
  height: 33.33vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.entry-grid {
  display: flex;
  justify-content: space-around;
  width: 100%;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.entry-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.entry-text {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.footer-section {
  width: 100%;
  height: 33.33vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: #fff;
  border-top: 1rpx solid #e9ecef;
}

.footer-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.hint-text {
  display: block;
  font-size: 24rpx;
  color: #95a5a6;
  margin-bottom: 12rpx;
}

.footer-slogan {
  display: block;
  font-size: 26rpx;
  color: #2c3e50;
  line-height: 1.5;
}
.page-header {
  text-align: center;
  padding: 32rpx 0 48rpx;
}

.logo-wrap {
  margin-bottom: 24rpx;
}

.logo {
  font-size: 80rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #7f8c8d;
}

.about-section {
  margin-bottom: 48rpx;
}

.about-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.about-text {
  display: block;
  font-size: 28rpx;
  color: #2c3e50;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.about-text:last-child {
  margin-bottom: 0;
}

.mission-section {
  margin-bottom: 48rpx;
}

.mission-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.mission-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.mission-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.mission-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 10rpx;
}

.mission-desc {
  display: block;
  font-size: 24rpx;
  color: #7f8c8d;
  line-height: 1.5;
}

.team-section {
  margin-bottom: 48rpx;
}

.team-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.team-member {
  text-align: center;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin: 0 auto 12rpx;
}

.member-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 6rpx;
}

.member-title {
  display: block;
  font-size: 22rpx;
  color: #95a5a6;
}

.contact-section {
  margin-bottom: 48rpx;
}

.contact-info {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.contact-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: 32rpx;
}

.contact-content {
  flex: 1;
}

.contact-label {
  display: block;
  font-size: 22rpx;
  color: #95a5a6;
  margin-bottom: 4rpx;
}

.contact-value {
  display: block;
  font-size: 26rpx;
  color: #2c3e50;
}

.cta-section {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 100rpx;
}

.cta-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.cta-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 24rpx;
}

.cta-section .btn-primary {
  background: #fff;
  color: #4a90d9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}
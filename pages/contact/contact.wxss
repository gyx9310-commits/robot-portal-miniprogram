.page-header {
  text-align: center;
  padding: 32rpx 0 48rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #7f8c8d;
}

.contact-form {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-of-type {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #2c3e50;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2c3e50;
  box-sizing: border-box;
  border: 1rpx solid #e9ecef;
}

.form-input::placeholder {
  color: #bdc3c7;
}

.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  border: 1rpx solid #e9ecef;
}

.radio-circle {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #bdc3c7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio-circle.checked {
  border-color: #4a90d9;
}

.radio-inner {
  width: 14rpx;
  height: 14rpx;
  background: #4a90d9;
  border-radius: 50%;
}

.radio-label {
  font-size: 26rpx;
  color: #2c3e50;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #2c3e50;
  box-sizing: border-box;
  border: 1rpx solid #e9ecef;
}

.form-textarea::placeholder {
  color: #bdc3c7;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.contact-info-section {
  margin-bottom: 40rpx;
}

.contact-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.contact-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: 36rpx;
}

.contact-detail {
  flex: 1;
}

.contact-title {
  display: block;
  font-size: 22rpx;
  color: #95a5a6;
  margin-bottom: 4rpx;
}

.contact-value {
  display: block;
  font-size: 26rpx;
  color: #2c3e50;
}
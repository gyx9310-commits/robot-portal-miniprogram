page {
  background: #0a0e1a;
}

.page-header {
  text-align: center;
  padding: 48rpx 0 40rpx;
  background: linear-gradient(180deg, #1a2744 0%, #0d1321 100%);
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  top: -50%;
  left: 50%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(74, 144, 217, 0.3) 0%, transparent 70%);
  transform: translateX(-50%);
  animation: headerGlow 4s ease-in-out infinite;
}

@keyframes headerGlow {
  0%, 100% {
    transform: translateX(-50%) scale(1);
    opacity: 0.5;
  }
  50% {
    transform: translateX(-50%) scale(1.3);
    opacity: 0.8;
  }
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 0 20rpx rgba(74, 144, 217, 0.5);
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}

.contact-form {
  background: linear-gradient(135deg, rgba(26, 39, 68, 0.6) 0%, rgba(13, 19, 33, 0.6) 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin: 32rpx 24rpx;
  border: 1rpx solid rgba(74, 144, 217, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3), 0 0 24rpx rgba(74, 144, 217, 0.1);
  position: relative;
  overflow: hidden;
}

.contact-form::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(74, 144, 217, 0.5), transparent);
}

.form-item {
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.form-item:last-of-type {
  margin-bottom: 36rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: rgba(10, 14, 26, 0.6);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #fff;
  box-sizing: border-box;
  border: 2rpx solid rgba(74, 144, 217, 0.25);
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #4a90d9;
  box-shadow: 0 0 16rpx rgba(74, 144, 217, 0.3);
  outline: none;
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(10, 14, 26, 0.6);
  border-radius: 16rpx;
  border: 2rpx solid rgba(74, 144, 217, 0.2);
  transition: all 0.3s ease;
}

.radio-item.selected {
  border-color: #4a90d9;
  background: rgba(74, 144, 217, 0.15);
  box-shadow: 0 0 12rpx rgba(74, 144, 217, 0.2);
}

.radio-circle {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.radio-item.selected .radio-circle {
  border-color: #4a90d9;
}

.radio-inner {
  width: 16rpx;
  height: 16rpx;
  background: #4a90d9;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.radio-item.selected .radio-inner {
  opacity: 1;
}

.radio-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: rgba(10, 14, 26, 0.6);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #fff;
  box-sizing: border-box;
  border: 2rpx solid rgba(74, 144, 217, 0.25);
  transition: all 0.3s ease;
  position: relative;
  z-index: 1;
}

.form-textarea:focus {
  border-color: #4a90d9;
  box-shadow: 0 0 16rpx rgba(74, 144, 217, 0.3);
  outline: none;
}

.form-textarea::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.btn-submit {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 32rpx rgba(74, 144, 217, 0.4), 0 0 24rpx rgba(74, 144, 217, 0.2);
  position: relative;
  z-index: 1;
  overflow: hidden;
  letter-spacing: 2rpx;
}

.btn-submit::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -30%;
  width: 160%;
  height: 200%;
  background: linear-gradient(135deg, transparent 0%, rgba(255, 255, 255, 0.15) 50%, transparent 100%);
  transform: rotate(45deg);
  animation: shimmer 5s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% {
    transform: translateX(-100%) rotate(45deg);
    opacity: 0;
  }
  50% {
    transform: translateX(100%) rotate(45deg);
    opacity: 1;
  }
}

.btn-submit::after {
  border: none;
}

.btn-submit:active {
  transform: scale(0.98);
}

.contact-info-section {
  margin: 0 24rpx 48rpx;
  position: relative;
  z-index: 1;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
  margin-bottom: 24rpx;
  position: relative;
  display: inline-block;
  width: 100%;
}

.section-title::before,
.section-title::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(74, 144, 217, 0.6), transparent);
}

.section-title::before {
  left: 20rpx;
}

.section-title::after {
  right: 20rpx;
}

.contact-card {
  background: linear-gradient(135deg, rgba(26, 39, 68, 0.6) 0%, rgba(13, 19, 33, 0.6) 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(74, 144, 217, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2), 0 0 16rpx rgba(74, 144, 217, 0.08);
  position: relative;
  overflow: hidden;
}

.contact-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(74, 144, 217, 0.4), transparent);
}

.contact-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(74, 144, 217, 0.1);
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: 40rpx;
  width: 48rpx;
  text-align: center;
}

.contact-detail {
  flex: 1;
}

.contact-title {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.contact-value {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.footer-section {
  text-align: center;
  padding: 40rpx 24rpx 60rpx;
  position: relative;
  z-index: 1;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 1rpx;
}